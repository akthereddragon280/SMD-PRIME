# 2. TMDB API Credentials (The Movie Database)
TMDB_API_KEY="your-tmdb-api-key"

# 3. Google Drive Service Account Credentials (7TB Cloud Folder Access)
GOOGLE_DRIVE_FOLDER_ID="19FJzU-ZrwOOVOmxginGpBMo3YQC1swXM"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-rsa-private-key\n-----END PRIVATE KEY-----"

# 4. Cloudflare Worker Video Stream Proxy URL
VITE_WORKER_PROXY_URL="https://tgstream.smd-prime.workers.dev"
